public class SegmentTreeDemo {

    static int[] tree;

    static void build(int[] arr,
                      int node,
                      int start,
                      int end) {

        if(start == end) {
            tree[node] = arr[start];
        }
        else {

            int mid =
                    (start + end) / 2;

            build(arr,
                    2 * node,
                    start,
                    mid);

            build(arr,
                    2 * node + 1,
                    mid + 1,
                    end);

            tree[node] =
                    tree[2 * node]
                    + tree[2 * node + 1];
        }
    }

    static int query(int node,
                     int start,
                     int end,
                     int l,
                     int r) {

        if(r < start || end < l)
            return 0;

        if(l <= start && end <= r)
            return tree[node];

        int mid =
                (start + end) / 2;

        int p1 =
                query(2 * node,
                        start,
                        mid,
                        l,
                        r);

        int p2 =
                query(2 * node + 1,
                        mid + 1,
                        end,
                        l,
                        r);

        return p1 + p2;
    }

    public static void main(String[] args) {

        int arr[] =
                {10,20,30,40,50};

        int n = arr.length;

        tree = new int[4 * n];

        build(arr,1,0,n-1);

        System.out.println(
                "Range Sum (1,3): "
                        + query(
                        1,
                        0,
                        n-1,
                        1,
                        3));
    }
}
