import java.util.ArrayList;

public class BPlusTreeDemo {

    public static void main(String[] args) {

        ArrayList<Integer> leafNodes =
                new ArrayList<>();

        int data[] =
                {10,20,30,40,50,60,70,80};

        for(int x : data)
            leafNodes.add(x);

        System.out.println(
                "B+ Tree Leaf Records:");

        for(int x : leafNodes)
            System.out.print(x + " ");

        System.out.println(
                "\n\nRange Query 20-60:");

        for(int x : leafNodes) {
            if(x >= 20 && x <= 60)
                System.out.print(x + " ");
        }
    }
}
